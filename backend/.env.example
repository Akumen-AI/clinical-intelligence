# --- AI Provider Configuration ---
# Options: "ollama" | "gemini" (falls back to gemini if ollama is unavailable)
AI_PROVIDER=ollama

# Ollama settings (model used for document classification)
OLLAMA_MODEL=qwen3:4b

# Gemini settings (required if AI_PROVIDER=gemini or as fallback)
GEMINI_API_KEY=your-gemini-api-key-here

# --- Classification Settings ---
# Confidence threshold for auto-classification (0.0 - 1.0)
# Documents below this threshold are flagged for manual review
DOCUMENT_CLASSIFICATION_THRESHOLD=0.80

# --- Database ---
# SQLite is used by default; override for PostgreSQL or other backends
# DATABASE_URL=sqlite:///./clinical_platform.db
