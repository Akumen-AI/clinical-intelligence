# --- AI Provider Configuration ---
# Options: "ollama" | "gemini" (falls back to gemini if ollama is unavailable)
AI_PROVIDER=ollama

# Ollama settings (model used for document classification)
OLLAMA_MODEL=qwen3:4b

# Gemini settings (required if AI_PROVIDER=gemini or as fallback)
GEMINI_API_KEY=your-gemini-api-key-here

# --- Classification Settings ---
# Confidence threshold for auto-classification (0.0 - 1.0)
# Documents below this threshold are flagged for manual review
DOCUMENT_CLASSIFICATION_THRESHOLD=0.80

# --- Database ---
# SQLite is used by default; override for PostgreSQL or other backends
# DATABASE_URL=sqlite:///./clinical_platform.db

# --- PaddlePaddle / OCR (Windows Compatibility) ---
# These flags fix a PaddleOCR crash on Windows caused by the oneDNN/PIR executor.
# They are set automatically in code, but can be overridden here if needed.
# FLAGS_use_mkldnn=0
# FLAGS_use_onednn=0
# FLAGS_enable_pir_api=0
# FLAGS_enable_pir_in_executor=0

# --- Handwriting Extraction Settings ---
# Enable/disable handwriting extraction path (requires GEMINI_API_KEY)
HANDWRITING_EXTRACTION_ENABLED=true
# Per-fragment OCR confidence threshold (printed text typically scores 0.9+)
HANDWRITING_OCR_CONFIDENCE_THRESHOLD=0.65
# Proportion of low-confidence fragments required to trigger handwriting routing
HANDWRITING_LOW_CONFIDENCE_PROPORTION=0.40

